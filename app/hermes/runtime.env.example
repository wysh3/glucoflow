# Internal service settings. Put actual values in a local ignored .env or the deployment secret store.
GLUCO_SERVICE_TOKEN=
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
MODEL_NAME=gpt-6-luna
# 0 = no cumulative app call allowance; concurrency and per-turn limits remain.
GLUCO_MAX_PROVIDER_CALLS_PER_HOUR=0
GLUCO_MAX_CONCURRENT=1
PORT=8080
