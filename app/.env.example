# Environment contract. Names and harmless placeholders only.
# Source: docs/mvp/08-deployment.md. Copy to .env for local development, or set these
# values in the hosting provider. Never commit a real value.

# ---------------------------------------------------------------------------
# Shared
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
PORT=8787
# API database role. Local development uses the generated sutra_api_login account;
# a hosted deployment uses a login role that can `set role` to the API privilege role.
DATABASE_URL_API=postgres://api_login:placeholder@127.0.0.1:5432/postgres
DATABASE_ROLE_API=sutra_api

# AUTH_MODE=local is development sign-in only and is refused when APP_ENV=production.
AUTH_MODE=local
AUTH_LOCAL_JWT_SECRET=replace-with-a-generated-local-secret
AUTH_LOCAL_ISSUER=sutra-local
AUTH_LOCAL_AUDIENCE=sutra-api

# AUTH_MODE=supabase requires these. The API verifies signature, issuer, audience and
# expiry against the project JWKS.
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated

# Storage: local filesystem for development, Supabase Storage for deployments.
STORAGE_MODE=local
STORAGE_LOCAL_ROOT=.local/storage
STORAGE_LOCAL_SECRET=replace-with-a-generated-local-secret
SUPABASE_STORAGE_SERVER_KEY=
STORAGE_BUCKET_SOURCES=sutra-sources
STORAGE_BUCKET_EXPORTS=sutra-exports

# Browser and Capacitor origins. The Android WebView serves bundled assets from
# https://localhost, so that origin must be listed for the installed app.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://localhost,capacitor://localhost

UPLOAD_MAX_BYTES=15728640
UPLOAD_MAX_PAGES=10
API_BASE_URL=http://127.0.0.1:8787
DEMO_LABEL=Synthetic demo

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
DATABASE_URL_WORKER=postgres://worker_login:placeholder@127.0.0.1:5432/postgres
DATABASE_ROLE_WORKER=sutra_worker
WORKER_CONCURRENCY=2

# fixture = deterministic rule engine, clearly labelled in the interface.
# openai-compatible = a live model. It refuses to start without a key, a base URL and
# positive budget limits, and it never falls back to fixture output.
EXTRACTION_PROVIDER=fixture
EXTRACTION_MODEL=deterministic-rules-v1
EXTRACTION_BASE_URL=
EXTRACTION_API_KEY=
MAX_DOCUMENT_MODEL_CALLS=12
MAX_DOCUMENT_COST_USD=
MAX_RUN_TOKENS=
MAX_DOCUMENT_USD_PER_MTOK_INPUT=
MAX_DOCUMENT_USD_PER_MTOK_OUTPUT=

OCR_ENABLED=true
OCR_LANG_PATH=
TMP_ROOT=.local/tmp

# ---------------------------------------------------------------------------
# Client (public configuration only, bundled into the web assets and the APK)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://127.0.0.1:8787
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_DEMO_LABEL=Synthetic demo

# ---------------------------------------------------------------------------
# Local-only helper values used by `pnpm db:start` and `pnpm db:migrate`.
# They are generated into .env (mode 600) and are not used in a deployment.
# ---------------------------------------------------------------------------
DATABASE_URL_OWNER=postgres://owner:placeholder@127.0.0.1:5432/postgres

# Contextual app guide. Keys stay on the API server; local help needs no key.
GUIDE_MODE=local
# Set GUIDE_API_KEY only for live mode (do not put it in VITE_ variables).
GUIDE_BASE_URL=https://api.openai.com/v1
GUIDE_MAX_CALLS_PER_HOUR=60
