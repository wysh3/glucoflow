          ]
        }
      ],
      "scale": {
        "minReplicas": 0,
        "maxReplicas": 1,
        "pollingInterval": 15,
        "cooldownPeriod": 120,
        "rules": [
          {
            "name": "postgres-queue",
            "custom": {
              "type": "postgresql",
              "metadata": {
                "query": "SELECT sutra.queue_depth()",
                "targetQueryValue": "1",
                "activationTargetQueryValue": "0"
              },
              "auth": [
                {
                  "secretRef": "scale-database-url",
                  "triggerParameter": "connection"
                }
              ]
            }
          }
        ]
      },
      "revisionSuffix": "live1"
