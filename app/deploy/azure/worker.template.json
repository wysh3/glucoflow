          "value": "REPLACE_LOCALLY_DO_NOT_COMMIT_CREDENTIALS"
        }
      ],
      "registries": [
        {
          "server": "glucoflowwysh2026.azurecr.io",
          "identity": "/subscriptions/bd8258cf-d425-494a-8e6d-0de3e6b09236/resourcegroups/glucoflow-demo/providers/Microsoft.ManagedIdentity/userAssignedIdentities/glucoflow-runtime"
        }
      ]
    },
    "template": {
      "containers": [
        {
