            {
              "name": "OCR_ENABLED",
              "value": "true"
            },
            {
              "name": "TMP_ROOT",
              "value": "/tmp/sutra-worker"
            },
            {
              "name": "EXTRACTION_BASE_URL",
              "value": "https://api.openai.com/v1"
            },
            {
              "name": "MAX_DOCUMENT_COST_USD",
              "value": "0.10"
            },
            {
              "name": "MAX_DOCUMENT_MODEL_CALLS",
              "value": "4"
            },
            {
              "name": "MAX_RUN_TOKENS",
              "value": "120000"
            },
            {
              "name": "MAX_DOCUMENT_USD_PER_MTOK_INPUT",
              "value": "0.125"
            },
            {
              "name": "MAX_DOCUMENT_USD_PER_MTOK_OUTPUT",
              "value": "0.5"
            },
            {
              "name": "SUPABASE_STORAGE_SERVER_KEY",
              "secretRef": "storage-key"
            },
            {
              "name": "DATABASE_URL_WORKER",
