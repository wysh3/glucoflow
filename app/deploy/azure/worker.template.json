            },
            {
              "name": "SUPABASE_URL",
              "value": "https://fynlsoxyazizblbmhwkn.supabase.co"
            },
            {
              "name": "STORAGE_BUCKET_SOURCES",
              "value": "sutra-sources"
            },
            {
              "name": "STORAGE_BUCKET_EXPORTS",
              "value": "sutra-exports"
            },
            {
              "name": "EXTRACTION_PROVIDER",
              "value": "openai-compatible"
            },
            {
              "name": "EXTRACTION_MODEL",
              "value": "gpt-6-luna"
            },
            {
              "name": "DEMO_LABEL",
              "value": "Synthetic demo"
            },
            {
              "name": "DATABASE_ROLE_API",
              "value": "sutra_api"
            },
            {
              "name": "DATABASE_ROLE_WORKER",
              "value": "sutra_worker"
            },
            {
              "name": "WORKER_CONCURRENCY",
              "value": "1"
