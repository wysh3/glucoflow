    "workloadProfileName": "Consumption",
    "configuration": {
      "activeRevisionsMode": "Single",
      "secrets": [
        {
          "name": "storage-key",
          "value": "REPLACE_LOCALLY_DO_NOT_COMMIT_CREDENTIALS"
        },
        {
          "name": "database-url",
          "value": "REPLACE_LOCALLY_DO_NOT_COMMIT_CREDENTIALS"
        },
        {
          "name": "model-key",
          "value": "REPLACE_LOCALLY_DO_NOT_COMMIT_CREDENTIALS"
        },
        {
