{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": [
    "apps/api/src/**/*.ts",
    "apps/worker/src/**/*.ts",
    "packages/contracts/src/**/*.ts",
    "packages/domain/src/**/*.ts",
    "packages/data/src/**/*.ts",
    "packages/extraction/src/**/*.ts",
    "scripts/**/*.ts",
    "scripts/**/*.mjs",
    "tests/integration/**/*.ts",
    "tests/extraction/**/*.ts",
    "tests/e2e/**/*.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
